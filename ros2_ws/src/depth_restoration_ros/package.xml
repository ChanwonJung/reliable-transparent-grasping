<?xml version="1.0"?>
<package format="3">
  <name>depth_restoration_ros</name>
  <version>0.1.0</version>
  <description>Single-view, scan-matched ROS adapter for HTTP depth restoration.</description>
  <maintainer email="jaewonheo1101@gmail.com">Jaewon Heo</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
